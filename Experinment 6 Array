//Program 6a: Program to remove specific element from Array Object
function remove_array_element(array, n)
{
var index = array.indexOf(n);
if (index > -1) {
array.splice(index, 1);
}
return array;
}
console.log(remove_array_element([2, 5, 9, 6], 5));

//Exp 6a: program to remove specific item from an array: Using For Loop
function removeltemFromArray(array, n) {
const newArray = [];
for (let i=0;i< array.length; i++) {
if(array[i] !==n) {
newArray.push(array[i]);
}
}
return newArray;
}
const result = removeltemFromArray([1, 2, 3, 4, 5], 2);
console.log(result);

